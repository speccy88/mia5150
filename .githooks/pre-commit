#!/bin/sh
set -eu
if [ "$(git config user.name)" != "Research Team" ] || [ "$(git config user.email)" != "anonymous" ]; then
  echo "Configure the generic author described in docs/PUBLICATION-PRIVACY.md before committing." >&2
  exit 1
fi
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Install Gitleaks before publishing changes." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --config .gitleaks.toml --redact=100 --max-decode-depth 1
