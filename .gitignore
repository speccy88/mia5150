# Local LaTeX tools, build products and review artifacts.
/.env
/.env.*
!/.env.example
/.tools/
/.cache/
/build/
/output/
/_site/
/tmp/
/*.aux
/*.bbl
/*.blg
/*.fdb_latexmk
/*.fls
/*.log
/*.out
/*.synctex.gz
/*.xdv
/*.pdf
.DS_Store
benchmark_bm25/test.jsonl

# Exclude generated runtimes and local credentials throughout experiment folders.
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.venv/
**/.env
**/.env.*
!**/.env.example
**/*.key

# Private credentials and privacy-audit backups.
*.pem
*.p12
*.pfx
*.kdbx
id_rsa
id_ed25519
.netrc
.pypirc
**/privacy-work/
**/private-history/

# Local paper outputs; preserved study PDFs remain tracked.
/paper/*.pdf
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.log
/paper/*.out
/paper/*.synctex.gz
/paper/*.fdb_latexmk
/paper/*.fls
